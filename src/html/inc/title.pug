#title
  h1
    img(src="img/logo.png" alt="电脑麻将")
  if page == 'autoplay'
    div 自动对战
  if page == 'netplay'
    div 网络对战
  .version ver. #{version}
  .loading Loading data...
  .start.hide(tabindex="0" role="button") 开始
  if page == 'netplay'
    .login.hide
      form.local(method="POST" action="server/auth/")
        input(name="name" placeholder="玩家名")
        input(name="passwd" value="*" type="hidden")
        input(type="submit" value="登録")
      form.hatena(method="POST" action="server/auth/hatena")
        .logo
        input(type="submit" value="用 Hatena 注册")
      form.google(method="POST" action="server/auth/google")
        .logo
        input(type="submit" value="用 Google 注册")
