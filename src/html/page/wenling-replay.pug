- var page = 'wenling-replay'

doctype html
html(lang="zh-CN")

  head
    include ../inc/meta

    title 温岭牌谱

    include ../inc/style
    include ../inc/script

  body.wl-replay
    include ../inc/loaderr
    include ../inc/navi

    #wr
      .wr-bar
        select#wr-select
        span#wr-counter
      #wr-board
      #wr-ctl
        button#wr-first 首
        button#wr-prev 上一手
        button#wr-next 下一手
        button#wr-last 末
      #wr-log

    style.
      body.wl-replay { margin: 0; background: #101512; color: #eee;
                       font-family: "Microsoft YaHei", sans-serif; }
      #wr { width: 900px; margin: 0 auto; position: relative; }
      .wr-bar { display: flex; align-items: center; justify-content: space-between;
                margin: 18px 0 12px; font-size: 13px; color: #9fd6bb; }
      .wr-bar select { background: #16302a; color: #cfe8db; border: 1px solid #24503f;
                       border-radius: 6px; padding: 5px 8px; font-size: 13px; min-width: 420px; }
      #wr-board { position: relative; height: 620px;
                  background: radial-gradient(circle at 50% 45%, #1d6b48, #124a31 70%);
                  border-radius: 12px; box-shadow: inset 0 0 60px rgba(0,0,0,.5); }
      #wr .pai { display: inline-block; width: 30px; height: 42px; margin: 1px; border-radius: 3px;
                 background: #fffdf5; vertical-align: middle; }
      #wr .seat { position: absolute; text-align: center; }
      #wr .seat .label { font-size: 12px; color: #cfe8db; margin-bottom: 2px; }
      #wr .seat.top    { top: 8px; left: 50%; transform: translateX(-50%); }
      #wr .seat.bottom { bottom: 12px; left: 50%; transform: translateX(-50%); width: 880px; }
      #wr .seat.left   { left: 8px; top: 45%; transform: translateY(-50%); width: 260px; }
      #wr .seat.right  { right: 8px; top: 45%; transform: translateY(-50%); width: 260px; }
      #wr .seat .hand { line-height: 1.05; }
      #wr .flowers { font-size: 11px; color: #ffd966; min-height: 14px; }
      #wr .melds { line-height: 0; min-height: 12px; }
      #wr .he { margin-top: 3px; line-height: 0; }
      #wr .he .pai { width: 20px; height: 28px; opacity: .8; }
      #wr .center { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%);
                    text-align: center; background: rgba(0,0,0,.45); border-radius: 10px;
                    padding: 8px 16px; }
      #wr .center .pai { width: 40px; height: 56px; }
      #wr .center .cap { font-size: 12px; color: #cfe8db; margin-top: 4px; }
      #wr .center .wall { font-size: 13px; margin-top: 4px; color: #ffd966; }
      #wr .center .nao { margin-top: 4px; color: #ff8a65; font-weight: bold; font-size: 13px; }
      #wr-ctl { display: flex; gap: 10px; justify-content: center; margin: 14px 0 10px; }
      #wr-ctl button { font-size: 14px; padding: 8px 20px; border-radius: 8px; border: none;
                       background: #2f7d5b; color: #fff; cursor: pointer; }
      #wr-ctl button:hover { background: #3c9a71; }
      #wr-ctl button:disabled { background: #24503f; color: #7f9a8d; cursor: default; }
      #wr-log { text-align: center; color: #cfe8db; font-size: 14px; height: 24px; }
      #wr-log .tag { color: #ffd966; margin-right: 8px; }
      #wr-empty { text-align: center; color: #9fd6bb; margin-top: 80px; font-size: 15px; }
