- var page = 'wenling'

doctype html
html(lang="zh-CN")

  head
    include ../inc/meta

    title 温岭麻将

    include ../inc/style
    include ../inc/script

  body.wenling
    include ../inc/loaderr
    include ../inc/navi

    #wl
      .wl-bar
        label
          input#wl-auto(type="checkbox")
          |  自动打牌
        label
          input#wl-tips-on(type="checkbox")
          |  牌效提示
        label
          input#wl-training(type="checkbox")
          |  训练模式
        label 速度
          select#wl-speed
            option(value="900") 慢
            option(value="450") 中
            option(value="150") 快
        button#wl-new 新的一局
        span#wl-ver
      .wl-main
        .wl-left
          #wl-board
          #wl-actions
        #wl-tips
      #wl-result.hide

    style.
      body.wenling { margin: 0; background: #101512; color: #eee;
                     font-family: "Microsoft YaHei", sans-serif; }
      #wl { width: min(1232px, calc(100vw - 24px)); margin: 0 auto; position: relative; }
      #wl .wl-main { display: flex; gap: 16px; align-items: flex-start; flex-wrap: wrap; }
      #wl .wl-left { width: 900px; max-width: 100%; overflow-x: auto; }
      #wl-tips { width: 316px; height: 620px; box-sizing: border-box; overflow-y: auto;
                 background: #16302a; border: 1px solid #24503f; border-radius: 12px;
                 padding: 14px 16px; font-size: 13px; color: #cfe8db; line-height: 1.6; }
      #wl-tips button { font-size: 13px; padding: 6px 14px; border-radius: 6px; border: none;
                        background: #2f7d5b; color: #fff; cursor: pointer; }
      #wl-tips button:hover { background: #3c9a71; }
      @media (max-width: 1260px) {
        #wl-tips { width: 900px; max-width: 100%; height: auto; min-height: 0; }
      }
      #wl-tips .tips-head { font-size: 15px; color: #ffd966; margin-bottom: 6px; }
      #wl-tips .tips-big { font-size: 24px; color: #e8f4ee; margin: 2px 0 8px; }
      #wl-tips .tips-sub { color: #9fd6bb; margin-top: 12px; }
      #wl-tips b { color: #7fd1a8; font-weight: normal; }
      #wl-tips .tile-list { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 6px; }
      #wl-tips .tile-list .item { position: relative; }
      #wl-tips .tile-list img { width: 26px; height: 36px; display: block; }
      #wl-tips .tile-list .n { position: absolute; right: -3px; bottom: -3px;
                               background: #0f1b16; border: 1px solid #2f6b52;
                               border-radius: 8px; font-size: 10px; padding: 0 3px; }
      #wl-tips .cand { color: #b9cdc3; }
      #wl .wl-bar { display: flex; align-items: center; justify-content: flex-end;
                    gap: 16px; margin-top: 18px; font-size: 13px; color: #9fd6bb; }
      #wl .wl-bar label { cursor: pointer; }
      #wl .wl-bar button { font-size: 13px; padding: 4px 12px; border-radius: 6px;
                           border: 1px solid #2f7d5b; background: transparent;
                           color: #9fd6bb; cursor: pointer; }
      #wl .wl-bar button:hover { background: #1d4d38; }
      #wl .wl-bar select { background: #16302a; color: #cfe8db; border: 1px solid #24503f;
                           border-radius: 6px; padding: 2px 6px; font-size: 13px; }
      #wl #wl-ver { font-size: 11px; color: #5d7a6d; margin-left: 4px; }
      #wl-board { position: relative; height: 620px; margin-top: 24px;
                  background: radial-gradient(circle at 50% 45%, #1d6b48, #124a31 70%);
                  border-radius: 12px; box-shadow: inset 0 0 60px rgba(0,0,0,.5); }
      #wl .pai { display: inline-block; width: 34px; height: 48px; margin: 1px; border-radius: 3px;
                 background: #fffdf5; vertical-align: middle; }
      #wl .pai.back { background: #2f7d5b; border: 1px solid #24614a; }
      #wl .seat { position: absolute; text-align: center; }
      #wl .seat .label { font-size: 13px; color: #cfe8db; margin-bottom: 2px; }
      #wl .seat .label.acting { color: #ffd966; font-weight: bold; }
      #wl .seat.top    { top: 8px; left: 50%; transform: translateX(-50%); }
      #wl .seat.bottom { bottom: 16px; left: 50%; transform: translateX(-50%); width: 880px; }
      #wl .seat.left   { left: 8px; top: 50%; transform: translateY(-50%); width: 150px; }
      #wl .seat.right  { right: 8px; top: 50%; transform: translateY(-50%); width: 150px; }
      #wl .seat .hand { line-height: 1.1; }
      #wl .seat.bottom .hand { min-height: 54px; }
      #wl .pai.selectable { cursor: pointer; outline: 2px solid #ffd966; }
      #wl .pai.selectable:hover { transform: translateY(-6px); }
      #wl .pai.recommend { outline: 3px solid #7fd1a8;
                           box-shadow: 0 0 10px rgba(127, 209, 168, .8); }
      #wl .pai.disabled { opacity: .3; cursor: not-allowed; }
      #wl .flowers { font-size: 12px; color: #ffd966; min-height: 16px; margin: 3px 0; }
      #wl .melds { font-size: 12px; color: #9fd6bb; min-height: 14px; line-height: 0; }
      #wl .he { margin-top: 4px; }
      #wl .he .pai { width: 24px; height: 34px; opacity: .85; }
      #wl .he .pai.just { opacity: 1; outline: 3px solid #ffd966;
                          box-shadow: 0 0 10px rgba(255, 217, 102, .9);
                          transform: translateY(-4px); }
      #wl .center .turn { margin-top: 8px; font-size: 13px; color: #7fd1a8; max-width: 160px; }
      #wl .center { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%);
                    text-align: center; background: rgba(0,0,0,.45); border-radius: 10px;
                    padding: 10px 18px; }
      #wl .center .pai { width: 46px; height: 64px; }
      #wl .center .cap { font-size: 12px; color: #cfe8db; margin-top: 4px; }
      #wl .center .wall { font-size: 14px; margin-top: 6px; color: #ffd966; }
      #wl .center .nao { margin-top: 6px; color: #ff8a65; font-weight: bold; }
      #wl-actions { height: 84px; display: flex; align-items: center; justify-content: center;
                    gap: 12px; }
      #wl-actions button { font-size: 17px; padding: 10px 26px; border-radius: 8px;
                           border: none; cursor: pointer; background: #2f7d5b; color: #fff; }
      #wl-actions button:hover { background: #3c9a71; }
      #wl-actions .hint { color: #9fd6bb; font-size: 15px; }
      #wl-actions button img.pai { width: 26px; height: 36px; vertical-align: middle;
                                   margin: 0 2px; border-radius: 2px; }
      #wl-result h2 img.pai.mini { width: 28px; height: 38px; vertical-align: middle;
                                   margin-left: 4px; border-radius: 2px; }
      #wl-result .next-hand { color: #9fd6bb; font-size: 13px; margin: 10px 0 12px; }
      #wl-result { position: absolute; inset: 0; background: rgba(0,0,0,.78);
                   display: flex; align-items: center; justify-content: center; z-index: 10; }
      #wl-result.hide { display: none; }
      #wl-result .card { background: #17352a; border: 1px solid #2f7d5b; border-radius: 12px;
                         padding: 24px 32px; min-width: 380px; text-align: left; }
      #wl-result h2 { margin: 0 0 12px; font-size: 22px; }
      #wl-result table { width: 100%; font-size: 14px; border-collapse: collapse; }
      #wl-result td { padding: 3px 8px; }
      #wl-result .num { text-align: right; color: #ffd966; }
      #wl-result button { margin-top: 16px; font-size: 16px; padding: 8px 24px;
                          border-radius: 8px; border: none; background: #2f7d5b; color: #fff;
                          cursor: pointer; }
      #wl-result a.replay { margin-left: 12px; color: #9fd6bb; font-size: 15px; }
